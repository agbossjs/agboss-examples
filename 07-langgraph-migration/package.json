{
  "name": "langgraph-migration",
  "version": "0.1.0",
  "private": true,
  "description": "AGBoss P0 showcase: Side-by-side comparison of raw LangGraph (before-langgraph/) vs AGBoss (after-agboss/)",
  "type": "module",
  "agboss": {
    "application": "after-agboss/src/support.application.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/after-agboss/src/support.application.js",
    "dev": "tsx watch after-agboss/src/support.application.ts",
    "demo": "tsx after-agboss/src/demo.ts",
    "check": "agboss check && tsc --noEmit && eslint .",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@agboss/core": "^0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@types/node": "^22.13.10",
    "@agboss/cli": "^0.1.0",
    "eslint": "^9.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  }
}
