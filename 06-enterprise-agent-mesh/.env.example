# Enterprise Agent Mesh — the variables the three applications read (names only, no values).
# `npm test`, `npm run demo` and `npm run check` run 100% offline: the tests and the demo set synthetic keys
# of their own (apps/1-order-gateway/src/scripts/offline-keys.ts, the vitest env). The applications fail closed at
# start without these.
PII_PSEUDONYM_KEY=
AGBOSS_IDEMPOTENCY_SECRET=
# the mesh: this application's Ed25519 private key (PKCS #8 PEM) and the public keys (SPKI PEM) of its peers
MESH_SIGNING_KEY=
TRIAGE_VERIFY_KEY=
BILLING_VERIFY_KEY=
# API keys: what the gateway presents to billing, the keys billing and the catalog know
BILLING_API_KEY=
BILLING_READONLY_API_KEY=
CATALOG_READER_API_KEY=
# a live run only
OPENROUTER_API_KEY=
