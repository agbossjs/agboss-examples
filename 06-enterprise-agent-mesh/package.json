{
  "name": "enterprise-agent-mesh",
  "version": "0.1.0",
  "private": true,
  "description": "AGBoss P1 proof: Multi-service A2A, MCP, Ed25519 mesh envelopes, loop detection, and federation blast-radius verification",
  "type": "module",
  "agboss": {
    "application": "src/enterprise-agent-mesh.application.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/enterprise-agent-mesh.application.js",
    "dev": "tsx watch src/enterprise-agent-mesh.application.ts",
    "demo": "tsx src/demo.ts",
    "check": "agboss check --application billing-service/billing.application.ts && agboss check --application catalog-mcp/catalog.application.ts && agboss check && tsc --noEmit && eslint .",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "agboss": "file:../.packed/agboss-0.1.0.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@types/node": "^22.13.10",
    "agboss-cli": "file:../.packed/agboss-cli-0.1.0.tgz",
    "eslint": "^9.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  },
  "overrides": {
    "agboss": "file:../.packed/agboss-0.1.0.tgz",
    "agboss-cli": "file:../.packed/agboss-cli-0.1.0.tgz"
  }
}
