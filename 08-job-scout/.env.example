# Copy to .env only for `npm run demo:live`.
# `npm run check`, `npm test`, and `npm run demo` run 100% offline without any API key.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# The application's PII pseudonym key (`pseudonymKey`): one token per value in every process.
# `npm run demo` uses a synthetic one; set your own for `npm run chat` and every deployment.
PII_PSEUDONYM_KEY=
