{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true
  },
  "include": [
    "src/**/*.ts",
    "triage-gateway/**/*.ts",
    "billing-service/**/*.ts",
    "catalog-mcp/**/*.ts",
    "federation/**/*.ts",
    "tests/**/*.ts",
    ".agboss/**/*.d.ts"
  ]
}
