{
  "name": "review-loop-and-routing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "P0 Proof: the same credit decision routed by code ($0, no model) and by a model, and a bounded review loop (historyOf with a limit, maxVisits with a defined finish).",
  "agboss": {
    "application": "src/credit-review.application.ts"
  },
  "scripts": {
    "types": "agboss check",
    "describe": "agboss describe",
    "lint": "eslint .",
    "check": "agboss check --strict --cassettes && tsc --noEmit && eslint .",
    "test": "vitest run",
    "demo": "tsx src/demo.ts",
    "demo:live": "tsx --env-file-if-exists=.env src/demo.ts --live"
  },
  "dependencies": {
    "@agboss/core": "^0.1.1"
  },
  "devDependencies": {
    "@agboss/cli": "^0.1.1",
    "@eslint/js": "^9.39.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.0"
  }
}
