{
  "name": "agboss-examples",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Executable architecture and reliability proofs for the AGBoss TypeScript AI agent framework — Promise -> Failure Injection -> Reproducible Proof.",
  "homepage": "https://agboss.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agbossjs/agboss-examples.git"
  },
  "bugs": {
    "url": "https://github.com/agbossjs/agboss-examples/issues"
  },
  "license": "Apache-2.0",
  "author": "Pavel Ravvich <hello@agboss.dev> (https://github.com/pavelravvich)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "pin:framework-sha": "node scripts/pin-framework-sha.mjs",
    "pack:framework": "node scripts/pack-framework.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "install:packed": "node scripts/install-packed.mjs",
    "install:packed:restore": "node scripts/install-packed.mjs --restore",
    "install:published": "node scripts/install-published.mjs",
    "install:published:restore": "node scripts/install-published.mjs --restore",
    "restore:public": "node scripts/install-packed.mjs --restore",
    "verify:published": "node scripts/verify-published.mjs",
    "run:all": "node scripts/run-all.mjs",
    "collect:results": "node scripts/collect-results.mjs",
    "collect:published": "node scripts/collect-results.mjs --provenance published --require-p1",
    "check": "node scripts/run-all.mjs --mode check",
    "test": "node scripts/run-all.mjs --mode test",
    "demo": "node scripts/run-all.mjs --mode demo",
    "test:tooling": "node --test scripts/run-all.test.mjs",
    "test:harness": "node --test scripts/run-all.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && node --test scripts/run-all.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
