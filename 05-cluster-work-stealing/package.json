{
  "name": "cluster-work-stealing",
  "version": "0.1.0",
  "private": true,
  "description": "AGBoss P1 proof: Distributed cluster work-stealing, 30s SQLite leases, crash recovery, backpressure, and cross-instance cancellation",
  "type": "module",
  "agboss": {
    "application": "src/cluster-work-stealing.application.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/cluster-work-stealing.application.js",
    "dev": "tsx watch src/cluster-work-stealing.application.ts",
    "demo": "tsx src/demo.ts",
    "check": "agboss check && tsc --noEmit && eslint .",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@agboss/core": "^0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@types/node": "^22.13.10",
    "@agboss/cli": "^0.1.0",
    "eslint": "^9.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  }
}
