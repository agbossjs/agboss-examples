# Copy to .env inside an individual example directory only when running `npm run demo:live`.
# Offline checks (`npm run check`), unit/integration tests (`npm test`), and default demos (`npm run demo`)
# run 100% deterministically at $0 and NEVER require an API key.
#
# SECURITY RULE (R6): Never commit .env files, real API credentials, or unredacted traces.

# OpenRouter API key (used by OpenRouterModelProvider & DecisionsModelProvider in live mode)
OPENROUTER_API_KEY=

# Optional OpenRouter endpoint override (proxy or local OpenAI-compatible server)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Deterministic HMAC pseudonymization secret for @PiiPolicy (any random string in local dev)
PII_PSEUDONYM_KEY=local-dev-synthetic-pseudonym-key-only

# Optional self-hosted Langfuse tracing (unset = no tracing)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=http://localhost:3000
