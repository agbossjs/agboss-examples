{
  "name": "langgraph-migration-smoke",
  "version": "0.1.0",
  "private": true,
  "description": "AGBoss P0 proof: LangGraph-to-AGBoss migration harness, 15-field StateAnnotation decomposition, and coding-agent skill verification",
  "type": "module",
  "agboss": {
    "application": "src/langgraph-migration-smoke.application.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/langgraph-migration-smoke.application.js",
    "dev": "tsx watch src/langgraph-migration-smoke.application.ts",
    "demo": "tsx src/demo.ts",
    "check": "agboss check && tsc --noEmit && eslint .",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "agboss": "file:../.packed/agboss-0.1.0.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@types/node": "^22.13.10",
    "agboss-cli": "file:../.packed/agboss-cli-0.1.0.tgz",
    "eslint": "^9.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  },
  "overrides": {
    "agboss": "file:../.packed/agboss-0.1.0.tgz",
    "agboss-cli": "file:../.packed/agboss-cli-0.1.0.tgz"
  }
}
