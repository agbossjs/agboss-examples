# Nothing to set: `npm run check`, `npm test` and `npm run demo` run 100% offline, $0 — a headless
# Chromium (`npm run browsers` installs it) against a site the demo and the tests start on 127.0.0.1;
# models are scripted. No key is needed.
#
# A live run (`npm run demo:live`): a cheap OpenRouter model, well under a cent. Copy to .env only for it.
OPENROUTER_API_KEY=

# The application's PII pseudonym key and the secret the business keys' fingerprints use: the demo
# uses synthetic ones; set your own for any real run.
# PII_PSEUDONYM_KEY=
# IDEMPOTENCY_KEY=

# Your own runs: the origins the browser may request (semicolon-separated) and the contact form.
# Everything else is refused, redirects included. Never list 127.0.0.1.
# BROWSER_ALLOWED_ORIGINS=https://docs.example.com;https://example.org
# CONTACT_FORM_URL=https://docs.example.com/contact
# CONTACT_LOOKUP_URL=https://docs.example.com
