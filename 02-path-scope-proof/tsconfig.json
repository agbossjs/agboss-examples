{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "cases/**/langgraph-broken/**/*.ts",
    "cases/**/agboss-fixed/**/*.ts",
    "vitest.config.ts",
    ".agboss/types.d.ts"
  ],
  "exclude": [
    "node_modules",
    "cases/**/agboss-broken/**"
  ]
}
