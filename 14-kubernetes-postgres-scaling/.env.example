# 14-kubernetes-postgres-scaling — nothing here calls a model: no key at all (R4, R6).
# `npm test` and `npm run demo` need nothing set. `npm start` (one pod on your machine) reads:
POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
PII_PSEUDONYM_KEY=local-dev-synthetic-pseudonym-key-only
IDEMPOTENCY_KEY=local-dev-synthetic-idempotency-key-only
LEDGER_URL=http://127.0.0.1:8081
POD_NAME=local
# The cluster takes its values from deploy/kind/infra.yaml (synthetic demo secrets).
